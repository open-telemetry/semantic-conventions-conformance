# Shared tool versions, sourced by CI workflows and by the local tooling in
# src/semconv_conformance/. Entries are kept up to date by the `versions.env`
# custom manager in .github/renovate.json5, which requires each variable to be
# immediately preceded by a `# renovate:` comment.

# renovate: datasource=github-releases depName=open-telemetry/weaver versioning=semver-coerced
WEAVER_VERSION=v0.22.1

# renovate: datasource=github-tags depName=open-telemetry/semantic-conventions versioning=semver-coerced
SEMCONV_VERSION=v1.40.0
