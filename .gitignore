.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Raw weaver reports from a run — one JSON per scenario, throwaway. The
# reduction over the whole run (data.json) is committed.
output/
results/

# Gradle: its caches, and everything a scenario's `setup` builds into them.
.gradle/
build/

# .NET: what a build and a scenario's `setup` compile into, anywhere in the
# tree, which is where the SDK puts them and not something a project chooses.
bin/
obj/
