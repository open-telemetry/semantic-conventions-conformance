<!--
  Copyright The OpenTelemetry Authors
  SPDX-License-Identifier: Apache-2.0

  The OpenTelemetry SDK release every .NET scenario exports through, pinned
  once. A domain's build root pins the instrumentation packages it measures
  and does not restate this, so a scenario in any domain flushes through the
  same SDK.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="OpenTelemetry" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>
</Project>
