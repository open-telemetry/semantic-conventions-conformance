{
  "name": "@otel-conformance/browser-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Runs a browser conformance scenario in headless Chrome and relays what it exports.",
  "license": "Apache-2.0",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./page": "./page.js",
    "./tracing": "./tracing.js",
    "./testing": "./testing.js"
  },
  "files": [
    "index.js",
    "page.js",
    "tracing.js",
    "testing.js"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1"
  }
}
