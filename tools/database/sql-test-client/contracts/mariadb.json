{
  "backend": "mariadb",
  "description": "The SQL scenarios every language executes against MariaDB.",
  "scenarios": {
    "statement": {
      "description": "Runs a direct query.",
      "action": {
        "kind": "query",
        "sql": "SELECT count(*) >= 0 FROM conformance.items"
      },
      "expect": {
        "spans": [
          {
            "match": {
              "attributes": {
                "db.system.name": "mariadb"
              }
            },
            "expect": {
              "count": 1,
              "attributes": {
                "db.namespace": "conformance",
                "db.query.summary": "SELECT conformance.items",
                "db.query.text": "SELECT count(*) >= ? FROM conformance.items",
                "server.address": "127.0.0.1",
                "server.port": {
                  "present": true
                }
              }
            }
          }
        ],
        "metrics": [
          "db.client.operation.duration",
          "queueSize"
        ],
        "events": []
      }
    },
    "prepared_statement": {
      "description": "Binds an integer to a prepared query.",
      "action": {
        "kind": "prepared_query",
        "sql": "SELECT name FROM conformance.items WHERE id = ${id}",
        "parameters": [
          {
            "name": "id",
            "type": "integer",
            "value": -1
          }
        ]
      },
      "expect": {
        "spans": [
          {
            "match": {
              "attributes": {
                "db.system.name": "mariadb"
              }
            },
            "expect": {
              "count": 1,
              "attributes": {
                "db.namespace": "conformance",
                "db.query.summary": "SELECT conformance.items",
                "db.query.text": "SELECT name FROM conformance.items WHERE id = ?",
                "server.address": "127.0.0.1",
                "server.port": {
                  "present": true
                }
              }
            }
          }
        ],
        "metrics": [
          "db.client.operation.duration",
          "queueSize"
        ],
        "events": []
      }
    },
    "batch": {
      "description": "Executes two inserts as one batch.",
      "action": {
        "kind": "batch",
        "statements": [
          "INSERT INTO conformance.items (id, name) VALUES (1, 'first')",
          "INSERT INTO conformance.items (id, name) VALUES (2, 'second')"
        ]
      },
      "expect": {
        "spans": [
          {
            "match": {
              "attributes": {
                "db.system.name": "mariadb"
              }
            },
            "expect": {
              "count": 1,
              "attributes": {
                "db.namespace": "conformance",
                "db.operation.batch.size": 2,
                "db.query.text": {
                  "present": true
                },
                "server.address": "127.0.0.1",
                "server.port": {
                  "present": true
                }
              }
            }
          }
        ],
        "metrics": [
          "db.client.operation.duration",
          "queueSize"
        ],
        "events": []
      }
    },
    "stored_procedure": {
      "description": "Calls the no-op stored procedure.",
      "action": {
        "kind": "stored_procedure",
        "procedure": "conformance.noop"
      },
      "expect": {
        "spans": [
          {
            "match": {
              "attributes": {
                "db.system.name": "mariadb"
              }
            },
            "expect": {
              "count": 1,
              "attributes": {
                "db.namespace": "conformance",
                "db.query.summary": "CALL conformance.noop",
                "db.query.text": "CALL conformance.noop()",
                "db.stored_procedure.name": "conformance.noop",
                "server.address": "127.0.0.1",
                "server.port": {
                  "present": true
                }
              }
            }
          }
        ],
        "metrics": [
          "db.client.operation.duration",
          "queueSize"
        ],
        "events": []
      }
    }
  }
}
