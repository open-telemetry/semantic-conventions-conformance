{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "packageRules": [
    {
      "groupName": "all patch versions",
      "matchUpdateTypes": ["patch"],
      "schedule": ["before 8am every weekday"]
    },
    {
      "matchUpdateTypes": ["minor", "major"],
      "schedule": ["before 8am on Monday"]
    },
    {
      // group all GitHub Actions updates into a single weekly PR
      // (Renovate applies packageRules in order and later rules win)
      "groupName": "github actions",
      "matchManagers": [
        "github-actions"
      ],
      "schedule": [
        "before 8am on Tuesday"
      ]
    },
    {
      "description": "Group all non-major Java dependency updates into a single PR",
      "matchManagers": ["gradle"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "java-minor"
    },
    {
      // The -alpha artifacts only publish `-alpha` releases; with the default
      // `ignoreUnstable: true` Renovate would never propose an upgrade.
      "matchPackageNames": [
        "io.opentelemetry.instrumentation:opentelemetry-instrumentation-bom-alpha",
        "io.opentelemetry.instrumentation:opentelemetry-armeria-1.3"
      ],
      "ignoreUnstable": false
    }
  ],
  "customManagers": [
    {
      // Pins in versions.env files; each carries its own `# renovate:` comment
      // naming its datasource.
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)versions\\.env$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?\\s+[A-Z_]+=(?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      // Keep the runtime coordinates reported by each Java scenario aligned
      // with the dependencies selected by its Gradle build.
      "customType": "regex",
      "managerFilePatterns": [
        "/^scenarios/http/java/.+/conformance\\.yaml$/"
      ],
      "matchStrings": [
        "instrumentation_library:\\s+(?<depName>[^\\s:]+:[^\\s:]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "maven"
    }
  ],
  "labels": [
    "dependencies"
  ]
}
