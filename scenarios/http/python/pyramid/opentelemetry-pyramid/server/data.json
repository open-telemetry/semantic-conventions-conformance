  "findings": [
    {
      "id": "http_span_name_format",
      "message": "Span '/health' should be named one of [\"GET\", \"GET /health\"]; a name built from the request path or URL makes every request a new span name.",
      "context": {
        "expected": [
          "GET",
          "GET /health"
        ],
        "kind": "server"
      }
    },
    {
