<Project>
  <!-- The toolchain is not this domain's to own: a second domain's .NET
       scenarios import the same file rather than restating any of it. -->
  <Import Project="../../../tools/dotnet/Directory.Build.props" />

  <PropertyGroup>
    <!-- Everything a `setup:` builds lands under the build root, flattened to
         one directory per project, so a scenario's `run:` names an assembly
         rather than a configuration and a target framework — and so a stale
         tree is one directory to delete. -->
    <PublishDir>$(ArtifactsPath)/scenario-runtime/$(MSBuildProjectName)/</PublishDir>
  </PropertyGroup>
</Project>
