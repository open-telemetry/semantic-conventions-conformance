<!--
  Copyright The OpenTelemetry Authors
  SPDX-License-Identifier: Apache-2.0

  The instrumentation releases this domain measures, pinned in one place. Only
  the client has one: the server is measured with what ASP.NET Core emits
  itself. The SDK they export through is pinned once for every domain, in
  tools/dotnet.

  Central package management is per directory tree rather than per build, so
  the shared projects under tools/ keep their own pins instead of reading
  these — see README.md.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
  </ItemGroup>
</Project>
