{
  "name": "open-telemetry-conformance/http-php-wordpress",
  "description": "WordPress HTTP server conformance measured by OpenTelemetry auto-instrumentation.",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "aaemnnosttv/wp-sqlite-db": "^1.3",
    "johnpbloch/wordpress": "^7.1",
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/opentelemetry-auto-wordpress": "^0.2",
    "open-telemetry/sdk": "^1.15",
    "open-telemetry/transport-grpc": "^1.2",
    "open-telemetry-conformance/http-test-client": "dev-main",
    "open-telemetry-conformance/scenario": "dev-main"
  },
  "scripts": {
    "prepare": "@php prepare.php",
    "post-install-cmd": "@prepare",
    "post-update-cmd": "@prepare"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "johnpbloch/wordpress-core-installer": true
    }
  },
  "extra": {
    "wordpress-install-dir": "vendor/wordpress"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../../../../tools/http/test-client/php",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../../../../../tools/php/scenario",
      "options": {
        "symlink": false
      }
    }
  ]
}
