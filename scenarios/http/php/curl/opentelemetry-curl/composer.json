{
  "name": "open-telemetry-conformance/http-php-curl",
  "description": "PHP curl HTTP client conformance measured by OpenTelemetry auto-instrumentation.",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/opentelemetry-auto-curl": "^0.3",
    "open-telemetry/sdk": "^1.15",
    "open-telemetry/transport-grpc": "^1.2",
    "open-telemetry-conformance/http-test-client": "dev-main",
    "open-telemetry-conformance/scenario": "dev-main"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../../../../tools/http/test-client/php",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../../../../../tools/php/scenario",
      "options": {
        "symlink": false
      }
    }
  ]
