{
  "name": "open-telemetry-conformance/http-php-symfony",
  "description": "Symfony HTTP server conformance measured by OpenTelemetry auto-instrumentation.",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.4.1",
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/opentelemetry-auto-symfony": "^1.4",
    "open-telemetry/sdk": "^1.15",
    "open-telemetry/transport-grpc": "^1.2",
    "open-telemetry-conformance/http-test-client": "dev-main",
    "symfony/event-dispatcher": "^8.0",
    "symfony/http-foundation": "^8.0",
    "symfony/http-kernel": "^8.0",
    "symfony/routing": "^7.4"
  },
  "config": {
    "platform": {
      "php": "8.4.1"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../../../../tools/http/test-client/php",
      "options": {
        "symlink": false,
        "versions": {
          "open-telemetry-conformance/http-test-client": "dev-main"
        }
      }
    }
  ]
}
