{
  "name": "open-telemetry-conformance/http-php-laravel",
  "description": "Laravel HTTP server conformance measured by OpenTelemetry auto-instrumentation.",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.3",
    "laravel/framework": "^13.0",
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/opentelemetry-auto-laravel": "^1.8",
    "open-telemetry/sdk": "^1.15",
    "open-telemetry/transport-grpc": "^1.2",
    "open-telemetry-conformance/http-test-client": "dev-main",
    "open-telemetry-conformance/scenario": "dev-main"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../../../../tools/http/test-client/php",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../../../../../tools/php/scenario",
      "options": {
        "symlink": false
      }
    }
  ]
}
