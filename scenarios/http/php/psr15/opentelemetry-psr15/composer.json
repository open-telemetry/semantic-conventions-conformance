{
  "name": "open-telemetry-conformance/http-php-psr15",
  "description": "PSR-15 HTTP server conformance measured by OpenTelemetry auto-instrumentation.",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.2",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/opentelemetry-auto-psr15": "^1.3",
    "open-telemetry/sdk": "^1.15",
    "open-telemetry/transport-grpc": "^1.2",
    "open-telemetry-conformance/http-test-client": "dev-main",
    "open-telemetry-conformance/scenario": "dev-main"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../../../../tools/http/test-client/php",
      "options": {
        "symlink": false
      }
