    {
      "id": "http_span_name_format",
      "message": "Client span 'GET 127.0.0.1' should be named one of [\"GET\"]; a name built from the request URL makes every request a new span name.",
      "signal_type": "span",
      "signal_name": "GET 127.0.0.1",
      "context": {
        "expected": [
          "GET"
        ],
        "kind": "client"
      }
    },
    {
      "id": "recommended_attribute_not_present",
      "message": "Span 'GET 127.0.0.1' is missing recommended attribute 'network.protocol.version'",
      "signal_type": "span",
      "signal_name": "GET 127.0.0.1",
      "context": {
        "attribute_key": "network.protocol.version",
        "kind": "client"
      }
    },
    {
      "id": "http_span_name_format",
